#!/bin/bash
#SBATCH --nodes=1
#SBATCH --error=err.%j
#SBATCH --output=out.%j
#SBATCH --ntasks=4
#SBATCH --cpus-per-task=1
#SBATCH --job-name=abacus
#SBATCH --partition=6338

module purge
module load gcc/12.1.0
module load oneapi/2024.0/compiler
module load oneapi/2024.0/mpi
module load oneapi/2024.0/mkl

source /fsb/home/jiansun/js_liny/software/abacus-develop-3.10.1/toolchain/abacus_env.sh

ulimit -c 0
export OMP_NUM_THREADS=1
export ASE_ABACUS_COMMAND='/fsb/home/jiansun/js_liny/software/abacus-develop-3.10.1/bin/abacus'

if [ ! -f finished ] && [ ! -f unfinished ] && [ ! -f computing ] && [ ! -f failed ]; then
   touch computing
   if ! srun --mpi=pmi2 -n 4 "$ASE_ABACUS_COMMAND" > log; then
      touch failed
      rm -f computing
      exit 1
   fi
   if grep -Eq 'CONVERGENCE HAS NOT BEEN ACHIEVED|SCF is unconverged' log; then
      touch unfinished
      rm -f computing
      exit 0
   fi
   touch finished
   rm -f computing
fi
