#!/bin/bash
#SBATCH --partition=97554090ib
#SBATCH --qos=normal
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --output=hotham.out.%j
#SBATCH --error=hotham.err.%j
#SBATCH --job-name=lcao_inference

set -eo pipefail
source /fsb/home/jiansun/js_liny/software_env/miniconda3/etc/profile.d/conda.sh
conda activate hotham_dev1
export PYTHONPATH="/fsb/home/jiansun/js_liny/software/Hot-Ham-dev1${PYTHONPATH:+:$PYTHONPATH}"
export OMP_NUM_THREADS=1
export PYTORCH_ALLOC_CONF=expandable_segments:True
MASTER_PORT=$((1000 + RANDOM % 50000))
torchrun --nproc_per_node=1 --master_port="$MASTER_PORT" -m hotham.entrypoints.main hotham-input.yaml > log.txt
